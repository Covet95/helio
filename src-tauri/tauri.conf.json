{
  "$schema": "https://schema.tauri.app/config/2.1",
  "productName": "Helio",
  "version": "0.1.1",
  "identifier": "com.helio.app",
  "build": {
    "beforeDevCommand": "npm --prefix gui run dev",
    "beforeBuildCommand": "npm --prefix gui run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../gui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Helio",
        "width": 900,
        "height": 650,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' http://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
