{
  "$schema": "https://schema.tauri.app/config/2.1",
  "productName": "Switch API",
  "version": "0.1.0",
  "identifier": "com.switchapi.app",
  "build": {
    "beforeDevCommand": "cd gui && npm run dev",
    "beforeBuildCommand": "cd gui && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../gui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Switch API",
        "width": 900,
        "height": 650,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
