{
  "$schema": "https://schema.tauri.app/config/2.1",
  "productName": "Helio",
  "version": "0.1.0",
  "identifier": "com.helio.app",
  "build": {
    "beforeDevCommand": "cd /Users/covet/Desktop/switch-api/gui && npm run dev",
    "beforeBuildCommand": "cd /Users/covet/Desktop/switch-api/gui && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../gui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Helio",
        "width": 900,
        "height": 650,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
